{
  "name": "blockchain-job-verification-system",
  "version": "1.0.0",
  "description": "Blockchain-Based Job Offer and Employment Verification System",
  "private": true,
  "scripts": {
    "compile": "hardhat compile",
    "test:contracts": "hardhat test",
    "node": "hardhat node",
    "deploy:local": "hardhat run scripts/deploy.js --network localhost",

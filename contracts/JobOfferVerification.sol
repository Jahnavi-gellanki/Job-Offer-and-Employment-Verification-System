pragma solidity ^0.8.19;

/**
 * @title JobOfferVerification
 * @author Blockchain Job Verification System
 * @notice Tamper-resistant job offer verification using cryptographic hashes
 * @dev Stores SHA-256 document hashes on-chain; no personal data is stored
 *
 * DEMO DISCLAIMER: This contract is for a college final-year demonstration project.
 * All entities are fictional. This does not constitute legal employment verification.
 */
contract JobOfferVerification {

    // ═══════════════════════════════════════════════════════════════
    //  Structs
    // ═══════════════════════════════════════════════════════════════

    /// @dev On-chain offer record — stores only minimum metadata + hash
    struct Offer {
        string   offerId;          // UUID generated by backend
        bytes32  documentHash;     // SHA-256 hash of the offer letter
        address  employerAddress;  // Wallet that registered the offer
        bool     isRevoked;
        uint256  issuedAt;         // block.timestamp of registration
        uint256  revokedAt;        // block.timestamp of revocation (0 if active)
    }

    /// @dev Employment verification record
    struct EmploymentRecord {
        address verifierAddress;
        uint256 verifiedAt;
        string  notes;             // Brief public notes (no PII)
    }

    // ═══════════════════════════════════════════════════════════════
    //  State Variables
    // ═══════════════════════════════════════════════════════════════

    address public owner;
    uint256 public totalOffersRegistered;
    uint256 public totalVerifications;

    mapping(string  => Offer)              private offers;
    mapping(address => bool)               public  registeredEmployers;
    mapping(string  => EmploymentRecord[]) private employmentVerifications;

    // ═══════════════════════════════════════════════════════════════
    //  Events
    // ═══════════════════════════════════════════════════════════════

    event EmployerRegistered(address indexed employer, uint256 timestamp);
    event EmployerRemoved   (address indexed employer, uint256 timestamp);

    event OfferRegistered(
        string  indexed offerId,
        bytes32         documentHash,
        address indexed employer,
        uint256         timestamp
    );

    event OfferVerified(
        string  indexed offerId,
        address indexed verifier,
        bool            isValid,
        uint256         timestamp
    );

    event OfferRevoked(
        string  indexed offerId,
        address indexed employer,
        uint256         timestamp
    );

    event EmploymentVerified(
        string  indexed offerId,
        address indexed verifier,
        uint256         timestamp
    );

    // ═══════════════════════════════════════════════════════════════
    //  Modifiers
    // ═══════════════════════════════════════════════════════════════

    modifier onlyOwner() {
        require(msg.sender == owner, "JOV: caller is not the owner");
        _;
    }

    modifier onlyEmployer() {
        require(
            registeredEmployers[msg.sender],
            "JOV: caller is not a registered employer"
        );
        _;
    }

    modifier offerExists(string memory offerId) {
        require(
            bytes(offers[offerId].offerId).length > 0,
            "JOV: offer does not exist"
        );
        _;
    }

    modifier offerNotRevoked(string memory offerId) {
        require(!offers[offerId].isRevoked, "JOV: offer has been revoked");
        _;
    }

    // ═══════════════════════════════════════════════════════════════
    //  Constructor
    // ═══════════════════════════════════════════════════════════════

    constructor() {
        owner = msg.sender;
        registeredEmployers[msg.sender] = true;
        emit EmployerRegistered(msg.sender, block.timestamp);
    }

    // ═══════════════════════════════════════════════════════════════
    //  Admin Functions
    // ═══════════════════════════════════════════════════════════════

    /**
     * @notice Register an employer wallet so it can issue offers
     * @param employer Ethereum address of the employer
     */
    function registerEmployer(address employer) external onlyOwner {
        require(employer != address(0), "JOV: invalid address");
        require(!registeredEmployers[employer], "JOV: already registered");
        registeredEmployers[employer] = true;
        emit EmployerRegistered(employer, block.timestamp);
    }

    /**
     * @notice Remove an employer from the registry
     * @param employer Ethereum address to remove
     */
    function removeEmployer(address employer) external onlyOwner {
        require(employer != owner, "JOV: cannot remove owner");
        registeredEmployers[employer] = false;
        emit EmployerRemoved(employer, block.timestamp);
    }

    /**
     * @notice Transfer contract ownership
     * @param newOwner New owner address
     */
    function transferOwnership(address newOwner) external onlyOwner {
        require(newOwner != address(0), "JOV: invalid address");
        owner = newOwner;
    }

    // ═══════════════════════════════════════════════════════════════
    //  Employer Functions
    // ═══════════════════════════════════════════════════════════════

    /**
     * @notice Register a new job offer — only the document hash is stored, NOT the document
     * @param offerId         UUID string from the backend database
     * @param documentHash    SHA-256 hash of the offer letter (as bytes32)
     */
    function registerOffer(
        string  memory offerId,
        bytes32        documentHash,
        address        /* candidateAddress */
    ) external onlyEmployer {
        require(bytes(offerId).length > 0,     "JOV: empty offer ID");
        require(documentHash != bytes32(0),    "JOV: empty document hash");
        require(
            bytes(offers[offerId].offerId).length == 0,
            "JOV: offer already registered"
        );

        offers[offerId] = Offer({
            offerId:         offerId,
            documentHash:    documentHash,
            employerAddress: msg.sender,
            isRevoked:       false,
            issuedAt:        block.timestamp,
            revokedAt:       0
        });

        totalOffersRegistered++;
        emit OfferRegistered(offerId, documentHash, msg.sender, block.timestamp);
    }

    /**
     * @notice Revoke a job offer — record is preserved for audit purposes
     * @param offerId The offer ID to revoke
     */
    function revokeOffer(string memory offerId)
        external
        onlyEmployer
        offerExists(offerId)
    {
        require(
            offers[offerId].employerAddress == msg.sender || msg.sender == owner,
            "JOV: not authorized to revoke"
        );
        require(!offers[offerId].isRevoked, "JOV: already revoked");

        offers[offerId].isRevoked  = true;
        offers[offerId].revokedAt  = block.timestamp;

        emit OfferRevoked(offerId, msg.sender, block.timestamp);
    }

    // ═══════════════════════════════════════════════════════════════
    //  Verification Functions
    // ═══════════════════════════════════════════════════════════════

    /**
     * @notice Verify whether a document hash matches a registered offer (emits event)
     * @param offerId       The offer to verify
     * @param documentHash  Hash to compare
     * @return isValid   True if hash matches AND offer is active
     * @return isRevoked Whether the offer has been revoked
     * @return timestamp When the offer was originally registered
     */
    function verifyOffer(string memory offerId, bytes32 documentHash)
        external
        offerExists(offerId)
        returns (bool isValid, bool isRevoked, uint256 timestamp)
    {
        Offer memory offer = offers[offerId];
        isValid   = !offer.isRevoked && offer.documentHash == documentHash;
        isRevoked = offer.isRevoked;
        timestamp = offer.issuedAt;

        totalVerifications++;
        emit OfferVerified(offerId, msg.sender, isValid, block.timestamp);
    }

    /**
     * @notice Record that employment status for this offer was verified by a third party
     * @param offerId         Related offer ID
     * @param verifierAddress Who performed the verification (recruiter, org, etc.)
     * @param notes           Brief public notes (no PII)
     */
    function recordEmploymentVerification(
        string  memory offerId,
        address        verifierAddress,
        string  memory notes
    ) external offerExists(offerId) offerNotRevoked(offerId) {
        employmentVerifications[offerId].push(EmploymentRecord({
            verifierAddress: verifierAddress,
            verifiedAt:      block.timestamp,
            notes:           notes
        }));
        emit EmploymentVerified(offerId, verifierAddress, block.timestamp);
    }

    // ═══════════════════════════════════════════════════════════════
    //  View / Pure Functions
    // ═══════════════════════════════════════════════════════════════

    /**
     * @notice Get non-sensitive offer metadata
     */
    function getOffer(string memory offerId)
        external
        view
        offerExists(offerId)
        returns (
            bytes32 documentHash,
            address employerAddress,
            bool    isRevoked,
            uint256 issuedAt,
            uint256 revokedAt
        )
    {
        Offer memory o = offers[offerId];
        return (o.documentHash, o.employerAddress, o.isRevoked, o.issuedAt, o.revokedAt);
    }

    /**
     * @notice Pure read — check hash match without emitting any event
     */
    function checkHashMatch(string memory offerId, bytes32 documentHash)
        external
        view
        offerExists(offerId)
        returns (bool)
    {
        return !offers[offerId].isRevoked && offers[offerId].documentHash == documentHash;
    }

    /// @notice Check if an offer ID is already registered
    function offerExistsCheck(string memory offerId) external view returns (bool) {
        return bytes(offers[offerId].offerId).length > 0;
    }

    /// @notice Get employment verification count for an offer
    function getEmploymentVerificationCount(string memory offerId)
        external
        view
        returns (uint256)
    {
        return employmentVerifications[offerId].length;
    }

    /// @notice Check if an address is a registered employer
    function isEmployerRegistered(address employer) external view returns (bool) {
        return registeredEmployers[employer];
    }
}

# =========================================================
# Blockchain-Based Job Offer & Employment Verification System
# Copy this file to .env in each directory and fill values
# =========================================================

# ─── Root / Hardhat ───────────────────────────────────────
# Private key of the deployer wallet (WITHOUT 0x prefix)
PRIVATE_KEY=your_wallet_private_key_without_0x_prefix
# Sepolia RPC URL (from Infura, Alchemy, or Ankr)
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_KEY

# ─── Server (copy to server/.env) ─────────────────────────
PORT=5000
MONGODB_URI=mongodb://localhost:27017/blockchain_job_verification
JWT_SECRET=change_this_to_a_long_random_secret_in_production
JWT_EXPIRE=7d
CLIENT_URL=http://localhost:5173

# Contract address after deployment (auto-updated by deploy script)
CONTRACT_ADDRESS=0xYourDeployedContractAddress
# Network: localhost | sepolia
NETWORK=localhost
CHAIN_ID=31337

# Hardhat node RPC (for local dev)
RPC_URL=http://127.0.0.1:8545
# Private key of contract owner account (Hardhat Account #0 by default)
OWNER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# ─── Client (copy to client/.env) ─────────────────────────
VITE_API_URL=http://localhost:5000/api
VITE_CONTRACT_ADDRESS=0xYourDeployedContractAddress
VITE_NETWORK_ID=31337
